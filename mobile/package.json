import React, { useEffect, useState } from 'react';
import {
  SafeAreaView,
  ScrollView,
  StyleSheet,
  Text,
  View,
  TouchableOpacity,
} from 'react-native';

const API_URL = 'https://apex-executive.onrender.com';

type DepartmentState = {
  name: string;
  status: string;
  signal: string;
};

export default function App() {
  const [summary, setSummary] = useState<any>(null);
  const [departments, setDepartments] = useState<DepartmentState[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const load = async () => {
      try {
        const [summaryRes, deptRes] = await Promise.all([
          fetch(`${API_URL}/api/dashboard/summary`),
          fetch(`${API_URL}/api/department-status`),
        ]);

        const summaryData = await summaryRes.json();
        const deptData = await deptRes.json();

        setSummary(summaryData);
        setDepartments(deptData.departments || []);
      } catch (error) {
        console.log('Dashboard load failed', error);
      } finally {
        setLoading(false);
      }
    };

    load();
  }, []);

  return (
    <SafeAreaView style={styles.safeArea}>
      <ScrollView contentContainerStyle={styles.container}>
        <Text style={styles.title}>Apex Executive</Text>
        <Text style={styles.subtitle}>CEO command center</Text>

        {loading ? (
          <Text style={styles.loading}>Loading…</Text>
        ) : (
          <>
            <View style={styles.grid}>
              <MetricCard label="Revenue MTD" value={`$${summary?.revenue_mtd?.toLocaleString() || '0'}`} />
              <MetricCard label="Treasury" value={`$${summary?.treasury?.toLocaleString() || '0'}`} />
              <MetricCard label="Agents" value={`${summary?.active_agents || 0}`} />
              <MetricCard label="Threats Blocked" value={`${summary?.threats_blocked || 0}`} />
            </View>

            <View style={styles.section}>
              <Text style={styles.sectionTitle}>Department Status</Text>
              {departments.map((dept) => (
                <View key={dept.name} style={styles.row}>
                  <View style={[styles.signal, styles[`signal_${dept.signal}` as keyof typeof styles] || styles.signal_green]} />
                  <View style={{ flex: 1 }}>
                    <Text style={styles.rowTitle}>{dept.name}</Text>
                    <Text style={styles.rowMeta}>{dept.status}</Text>
                  </View>
                </View>
              ))}
            </View>

            <View style={styles.section}>
              <Text style={styles.sectionTitle}>Executive Controls</Text>
              <TouchableOpacity style={styles.buttonPrimary}>
                <Text style={styles.buttonText}>Approve Queue</Text>
              </TouchableOpacity>
              <TouchableOpacity style={styles.buttonSecondary}>
                <Text style={styles.buttonText}>CEO Intercom</Text>
              </TouchableOpacity>
            </View>
          </>
        )}
      </ScrollView>
    </SafeAreaView>
  );
}

function MetricCard({ label, value }: { label: string; value: string }) {
  return (
    <View style={styles.metricCard}>
      <Text style={styles.metricLabel}>{label}</Text>
      <Text style={styles.metricValue}>{value}</Text>
    </View>
  );
}

const styles = StyleSheet.create({
  safeArea: {
    flex: 1,
    backgroundColor: '#06131f',
  },
  container: {
    padding: 20,
    gap: 18,
  },
  title: {
    color: '#edf6ff',
    fontSize: 34,
    fontWeight: '800',
  },
  subtitle: {
    color: '#94a3b8',
    fontSize: 16,
    marginTop: -8,
  },
  loading: {
    color: '#dbeafe',
    fontSize: 18,
    paddingVertical: 18,
  },
  grid: {
    flexDirection: 'row',
    flexWrap: 'wrap',
    gap: 12,
    justifyContent: 'space-between',
  },
  metricCard: {
    width: '48%',
    backgroundColor: '#0f1f2d',
    borderColor: '#1e293b',
    borderWidth: 1,
    borderRadius: 16,
    padding: 16,
  },
  metricLabel: {
    color: '#94a3b8',
    fontSize: 12,
    textTransform: 'uppercase',
    letterSpacing: 0.08,
  },
  metricValue: {
    color: '#edf6ff',
    fontSize: 22,
    fontWeight: '700',
    marginTop: 8,
  },
  section: {
    backgroundColor: '#0f1f2d',
    borderColor: '#1e293b',
    borderWidth: 1,
    borderRadius: 18,
    padding: 14,
  },
  sectionTitle: {
    color: '#dbeafe',
    fontSize: 18,
    fontWeight: '700',
    marginBottom: 12,
  },
  row: {
    flexDirection: 'row',
    alignItems: 'center',
    paddingVertical: 12,
    borderColor: '#1e293b',
    borderBottomWidth: 1,
  },
  rowTitle: {
    color: '#edf6ff',
    fontWeight: '600',
  },
  rowMeta: {
    color: '#94a3b8',
    marginTop: 4,
  },
  signal: {
    width: 10,
    height: 10,
    borderRadius: 999,
    marginRight: 12,
  },
  signal_green: { backgroundColor: '#4ade80' },
  signal_amber: { backgroundColor: '#fbbf24' },
  signal_blue: { backgroundColor: '#60a5fa' },
  signal_red: { backgroundColor: '#f87171' },
  buttonPrimary: {
    backgroundColor: '#2563eb',
    borderRadius: 12,
    paddingVertical: 14,
